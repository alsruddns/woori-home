# Development only. Copy to .env.local and replace both placeholders locally.
# The migration runner rejects non-local hosts and any database other than this exact name.
DB_TARGET=development
WORLD_BANK_DATA_SOURCE=json
DATABASE_URL=postgresql://<DEV_USER>:<DEV_PASSWORD>@localhost:5432/woori_today_portal_dev
DB_MIGRATION_URL=postgresql://<DEV_USER>:<DEV_PASSWORD>@localhost:5432/woori_today_portal_dev

# SEC EDGAR public company-facts API identifies automated callers with this header.
SEC_EDGAR_USER_AGENT=Woori.today financial data contact krdd125@gmail.com
# OpenDART collection stays disabled until an API key and public-use rights review are complete.
# OPENDART_API_KEY=
# Optional dedicated SELECT-only finance connection; otherwise the read-only pool reuses DATABASE_URL.
# FINANCIAL_READONLY_DATABASE_URL=postgresql://<READONLY_USER>:<PASSWORD>@localhost:5432/woori_today_portal_dev

# Production migration is blocked unless an operator explicitly sets this after approval.
# Never put production values in a developer's .env.local.
# DB_TARGET=production
# DATABASE_URL=postgresql://<PORTAL_DB_USER>:<PORTAL_DB_PASSWORD>@<APPROVED_HOST>:5432/woori_today_portal
# DB_MIGRATION_URL=postgresql://<PORTAL_MIGRATOR_USER>:<PORTAL_MIGRATOR_PASSWORD>@<APPROVED_HOST>:5432/woori_today_portal
# DB_MIGRATION_ALLOW_PRODUCTION=I_HAVE_APPROVAL
